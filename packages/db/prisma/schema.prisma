// Core Directory — référentiel unique des personnes (voir section 5 du dossier de passation).
// Seul le module RH est autorisé à créer un Person / une Affectation initiale ;
// cette règle est imposée côté API (apps/api), pas ici.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; le binaire musl/openssl3 pour l'image
  // Docker de production (node:22-alpine, voir apps/api/Dockerfile).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AffectationStatus {
  Actif
  Inactif
  Suspendu
}

enum CoreEventType {
  EmployeeCreated
  EmployeeUpdated
  EmployeeActivated
  EmployeeDeactivated
  EmployeeTransferred
  EmployeeDeleted
  RoleAssigned
  RoleRemoved
}

model Person {
  id        String   @id @default(uuid()) @map("person_id")
  firstName String
  lastName  String
  gender    String
  birthDate DateTime?
  photoUrl  String?
  email     String   @unique
  phone     String?
  address   String?

  account      Account?
  affectations Affectation[]
  roles        Role[]
  events       CoreEvent[]

  // Le CRM ne référence jamais qu'un person_id ici — jamais de copie du nom/statut.
  contactsHandled CrmContact[] @relation("ContactHandledBy")
  dealsOwned      CrmDeal[]    @relation("DealOwner")

  // Idem pour les Projets : jamais un nom stocké, uniquement des références.
  projectMemberships  ProjectMember[]
  tasksAssigned       ProjectTask[]        @relation("TaskAssignee")
  taskCommentsWritten ProjectTaskComment[] @relation("TaskCommentAuthor")

  // Documents (GED) — le dossier de passation (section 5) cite explicitement
  // Documents parmi les modules devant "Sélectionner une personne existante" :
  // le propriétaire d'un document est donc un person_id, jamais un nom libre.
  documentsOwned Document[] @relation("DocumentOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("people")
}

/// Une affectation = le lien entre une personne et une société (filiale) à un instant donné.
/// Changement de société -> exitDate posée sur l'ancienne + nouvelle ligne créée (jamais de suppression).
model Affectation {
  id         String            @id @default(uuid())
  personId   String            @map("person_id")
  person     Person            @relation(fields: [personId], references: [id], onDelete: Cascade)

  society    String
  department String
  position   String
  manager    String?

  entryDate DateTime
  exitDate  DateTime?

  status      AffectationStatus @default(Actif)
  replacement String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society, position])
  @@index([personId])
  @@map("affectations")
}

/// Identifiants de connexion — 1:1 avec Person. Un compte lié à un Person dont
/// toutes les affectations sont Inactif ne doit plus pouvoir se connecter.
model Account {
  personId     String   @id @map("person_id")
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  username     String   @unique
  passwordHash String
  mfaEnabled   Boolean  @default(false)
  lastLogin    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

/// Rôles applicatifs par société (RBAC), ex. "RH", "Commercial", "Validateur Finance".
model Role {
  id       String @id @default(uuid())
  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  society String
  role    String

  createdAt DateTime @default(now())

  @@index([personId])
  @@index([society, role])
  @@map("roles")
}

/// Journal d'événements Core Directory (MVP en table + polling, avant Redis Streams/Kafka).
model CoreEvent {
  id          String        @id @default(uuid())
  type        CoreEventType
  personId    String?       @map("person_id")
  person      Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName  String
  description String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("core_events")
}

// ============================================================
// CRM — pipeline, contacts, contrats (Phase 2). Scopé par société
// (contrairement au Core Directory qui est global). Le "commercial en
// charge" et le "traité par" ne sont JAMAIS un nom en dur : uniquement
// un person_id résolu à la volée via PeopleService (GET /people).
// ============================================================

enum DealStage {
  prospect
  qualification
  proposition
  negociation
  gagne
  perdu
}

enum ActivityType {
  call
  email
  whatsapp
  note
}

model CrmContact {
  id      String @id @default(uuid())
  society String

  name       String
  email      String?
  phone      String?
  company    String?
  position   String?
  referredBy String?
  entryDate  DateTime?
  tags       String[] @default([])

  // "Traité par" — jamais un nom stocké, uniquement une référence Core Directory.
  handledById String? @map("handled_by_person_id")
  handledBy   Person? @relation("ContactHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  deals CrmDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("crm_contacts")
}

model CrmDeal {
  id        String     @id @default(uuid())
  society   String
  contactId String     @map("contact_id")
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title String
  value Int       @default(0)
  stage DealStage @default(prospect)

  // "Commercial en charge" — jamais un nom stocké, uniquement une référence Core Directory.
  ownerPersonId String? @map("owner_person_id")
  owner         Person? @relation("DealOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)

  nextActionDate DateTime?

  activities CrmActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society, stage])
  @@map("crm_deals")
}

model CrmActivity {
  id     String       @id @default(uuid())
  dealId String       @map("deal_id")
  deal   CrmDeal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type   ActivityType
  text   String
  date   DateTime     @default(now())

  @@index([dealId])
  @@map("crm_activities")
}

// ============================================================
// PROJETS (Phase 3) — Kanban, Timeline, Budget, Équipe, Risques.
// Scopé par société, comme le CRM. L'équipe, l'assigné d'une tâche et
// l'auteur d'un commentaire ne sont JAMAIS un nom en dur : uniquement un
// person_id résolu via DirectoryLookupService (GET /people?society=).
// ============================================================

enum ProjectStatus {
  actif
  suspendu
  clos
}

enum TaskColumn {
  todo
  inprogress
  review
  done
}

model Project {
  id      String        @id @default(uuid())
  society String
  name    String
  client  String?
  status  ProjectStatus @default(actif)

  startDate DateTime
  endDate   DateTime
  budget    Int       @default(0)

  members  ProjectMember[]
  tasks    ProjectTask[]
  expenses ProjectExpense[]
  risks    ProjectRisk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("projects")
}

/// L'équipe du projet — un person_id par ligne, jamais un nom.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, personId])
  @@index([personId])
  @@map("project_members")
}

model ProjectTask {
  id        String     @id @default(uuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title  String
  column TaskColumn @default(todo)
  sprint String?

  assigneeId  String?  @map("assignee_person_id")
  assignee    Person?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  timeLoggedH Int       @default(0)

  checklist ProjectTaskChecklistItem[]
  comments  ProjectTaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, column])
  @@map("project_tasks")
}

model ProjectTaskChecklistItem {
  id     String      @id @default(uuid())
  taskId String      @map("task_id")
  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("project_task_checklist_items")
}

/// L'auteur est toujours l'acteur authentifié qui poste le commentaire
/// (jamais un champ libre côté client) — voir TasksService.addComment().
model ProjectTaskComment {
  id       String      @id @default(uuid())
  taskId   String      @map("task_id")
  task     ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String      @map("author_person_id")
  author   Person      @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text     String
  date     DateTime    @default(now())

  @@index([taskId])
  @@map("project_task_comments")
}

model ProjectExpense {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label    String
  amount   Int
  category String
  date     DateTime

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_expenses")
}

/// `level` (Faible/Modéré/Élevé/Critique) et `status` (Ouvert/Clôturé) restent des
/// String validées côté DTO plutôt que des enums Prisma — les accents ne sont pas
/// des identifiants d'enum valides, comme pour AffectationStatus historiquement.
model ProjectRisk {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  text       String
  level      String
  mitigation String?
  status     String  @default("Ouvert")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_risks")
}

// ============================================================
// FINANCE (Phase 3) — factures, dépenses, budgets, cash flow multi-devises.
// Scopé par société. Aucune référence au Core Directory ici : le prototype
// ne lie ni facture ni dépense à une personne interne (client = société
// externe, en texte libre) — rien à résoudre via DirectoryLookupService.
// ============================================================

enum Currency {
  EUR
  USD
  GBP
}

/// `status` (En attente/Payée/En retard, Payée/En attente) reste une String
/// validée côté DTO — mêmes raisons d'accents que ProjectRisk.
model FinanceInvoice {
  id      String   @id @default(uuid())
  society String

  client   String
  amount   Int
  currency Currency @default(EUR)
  status   String   @default("En attente")

  issueDate DateTime
  dueDate   DateTime
  category  String   @default("Vente de services")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("finance_invoices")
}

model FinanceExpense {
  id      String   @id @default(uuid())
  society String

  label    String
  amount   Int
  currency Currency @default(EUR)
  category String
  date     DateTime
  status   String   @default("Payée")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@index([society, category])
  @@map("finance_expenses")
}

model FinanceBudget {
  id      String @id @default(uuid())
  society String

  category String
  budgeted Int
  period   String @default("Mensuel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("finance_budgets")
}

// ============================================================
// GOUVERNANCE (Phase 3) — organigramme du Conseil, actionnariat/cap table,
// assemblées & résolutions, PV, historique des décisions.
// Scopé par société. À la différence du CRM/Projets, membres du Conseil et
// actionnaires restent en texte libre (jamais de FK Person) : un Conseil peut
// inclure des personnes hors Core Directory (administrateurs indépendants,
// représentants d'investisseurs) — le prototype ne les lie à aucune personne
// interne, et la Gouvernance n'apparaît pas dans la liste des modules tenus
// d'utiliser "Sélectionner une personne existante" (section 5 du dossier).
// ============================================================

enum BoardRole {
  presidence
  direction
  administrateur
}

enum MeetingType {
  ca
  ag
}

/// Une ligne par société — valorisation courante utilisée pour calculer la
/// valeur estimée de chaque actionnaire dans le cap table.
model GovernanceValuation {
  society   String   @id
  valuation Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BoardMember {
  id      String    @id @default(uuid())
  society String

  name  String
  role  BoardRole
  title String
  since String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("governance_board_members")
}

/// `type` ("Personne"/"Société") reste une String — mêmes raisons d'accents
/// que pour ProjectRisk/FinanceInvoice.
model Shareholder {
  id      String @id @default(uuid())
  society String

  name       String
  type       String
  percentage Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("governance_shareholders")
}

model GovernanceMeeting {
  id      String      @id @default(uuid())
  society String

  type   MeetingType
  title  String
  date   DateTime
  status String      @default("Planifiée")
  agenda String[]
  minutes String     @default("")

  resolutions GovernanceResolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([society])
  @@map("governance_meetings")
}

model GovernanceResolution {
  id        String            @id @default(uuid())
  meetingId String            @map("meeting_id")
  meeting   GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  text          String
  votesFor      Int    @default(0)
  votesAgainst  Int    @default(0)
  votesAbstain  Int    @default(0)
  status        String @default("En délibération")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
  @@map("governance_resolutions")
}

// ============================================================
// INVESTISSEMENTS (VC) — Phase 3, portée Groupe.
// Contrairement à tous les modules précédents, aucune colonne `society` ici :
// le prototype présente ce module sous un bandeau "ATFM Legacy · Vue groupe"
// (voir InvestissementsMain) — c'est la holding qui pilote le portefeuille de
// participations pour tout le groupe, pas une filiale isolée. Côté API,
// l'accès est réservé aux personnes ayant une affectation active chez la
// société holding ("atfm"), via assertGroupAccess — pas un assertSocietyMember
// par société cible puisqu'il n'y en a pas.
// Co-investisseurs (StartupInvestor) et Cap Table (StartupCapTableEntry)
// restent en texte libre comme en Gouvernance : ce sont souvent des fonds ou
// personnes hors Core Directory.
// ============================================================

enum InvestmentStage {
  sourcing
  pitch
  dd
  termsheet
  investi
  refuse
}

model Startup {
  id          String          @id @default(uuid())
  name        String
  sector      String
  stage       InvestmentStage @default(sourcing)
  founder     String
  description String          @default("")

  pitchNotes        String @default("") @map("pitch_notes")
  businessPlanNotes String @default("") @map("business_plan_notes")

  /// Statut de Due Diligence ("Non démarrée"/"En cours"/"Terminée") — accentué,
  /// donc String + @IsIn côté DTO (même raison que ProjectRisk/Finance/Gouvernance).
  dueDiligenceStatus String @default("Non démarrée") @map("due_diligence_status")

  /// Tour visé ("Pre-seed"/"Seed"/"Série A"...) — accentué → String.
  round        String @default("Seed")
  amountTarget Int    @default(0) @map("amount_target")
  amountRaised Int    @default(0) @map("amount_raised")
  /// "Non démarrée"/"En cours"/"Clôturée" — accentué → String.
  roundStatus  String @default("Non démarrée") @map("round_status")

  valuationPreMoney  Int? @map("valuation_pre_money")
  valuationPostMoney Int? @map("valuation_post_money")
  currentValuation   Int  @default(0) @map("current_valuation")

  atfmInvested        Int       @default(0) @map("atfm_invested")
  atfmStakePercentage Int       @default(0) @map("atfm_stake_percentage")
  dateInvested        DateTime? @map("date_invested")

  dueDiligenceItems StartupDueDiligenceItem[]
  capTable          StartupCapTableEntry[]
  investors         StartupInvestor[]
  history           StartupHistoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("startups")
}

model StartupDueDiligenceItem {
  id        String  @id @default(uuid())
  startupId String  @map("startup_id")
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  text String
  done Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([startupId])
  @@map("startup_due_diligence_items")
}

/// Cap table par startup — `investor` en texte libre (fondateurs, business angels,
/// fonds...), jamais de FK Person (même logique que Shareholder en Gouvernance).
model StartupCapTableEntry {
  id        String  @id @default(uuid())
  startupId String  @map("startup_id")
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  investor   String
  percentage Int
  amount     Int    @default(0)

  createdAt DateTime @default(now())

  @@index([startupId])
  @@map("startup_cap_table_entries")
}

/// Co-investisseurs externes d'une startup. La vue "Investisseurs" du module
/// (agrégation par nom across startups) est calculée à la volée dans le
/// service, jamais stockée à part (même principe que le Cap Table de
/// Gouvernance ou l'Historique des décisions).
model StartupInvestor {
  id        String  @id @default(uuid())
  startupId String  @map("startup_id")
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  name    String
  /// "VC"/"Business Angels"/"Fonds à impact"/"Family Office"/"Corporate VC" — accentué → String.
  type    String
  contact String @default("")

  createdAt DateTime @default(now())

  @@index([startupId])
  @@map("startup_investors")
}

model StartupHistoryEvent {
  id        String  @id @default(uuid())
  startupId String  @map("startup_id")
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  event       String
  description String   @default("")
  date        DateTime

  createdAt DateTime @default(now())

  @@index([startupId])
  @@map("startup_history_events")
}

// ============================================================
// DOCUMENTS (GED) — Phase 3, par société (comme le CRM/Projets/Finance).
// `category` reprend DOC_CATEGORIES du prototype : mots simples sans accent,
// valides comme identifiants d'enum (contrairement à DOC_PERMISSIONS et
// signatureStatus, accentués/avec espaces → String + @IsIn côté DTO).
// `ownerPersonId` est un person_id du Core Directory : le dossier de
// passation (section 5) cite "Documents" parmi les modules qui doivent
// "Sélectionner une personne existante" plutôt que stocker un nom libre —
// résolu via DirectoryLookupService, jamais un nom copié en dur.
// ============================================================

enum DocumentCategory {
  Contrats
  Gouvernance
  Finance
  RH
  Projets
}

model Document {
  id      String @id @default(uuid())
  society String

  name     String
  category DocumentCategory
  version  Int              @default(1)

  /// Mise à jour uniquement par une nouvelle version (voir DocumentsService.newVersion) —
  /// jamais touchée par l'archivage, le cycle de permissions ou la signature.
  updatedDate DateTime @default(now()) @map("updated_date")

  ownerPersonId String @map("owner_person_id")
  owner         Person @relation("DocumentOwner", fields: [ownerPersonId], references: [id], onDelete: Cascade)

  /// "Public interne"/"Restreint"/"Direction uniquement" — espaces → String + @IsIn.
  permissions String @default("Public interne")
  archived    Boolean @default(false)

  /// "Signé"/"En attente", ou null si la catégorie n'implique pas de signature
  /// (seuls les Contrats en ont une à la création, voir DocumentsService.create).
  signatureStatus String? @map("signature_status")

  createdAt DateTime @default(now())

  @@index([society])
  @@index([society, category])
  @@map("documents")
}

// ============================================================
// INTÉGRATIONS — Phase 4, connecteur Odoo réel, par société.
// Contrairement au prototype (connexion simulée par un setTimeout, identifiants
// dans le localStorage du navigateur), l'API Odoo est réellement appelée en
// JSON-RPC depuis le backend (voir apps/api/src/integrations/odoo/odoo-client.ts)
// et la clé API n'est JAMAIS renvoyée au navigateur après écriture — seul son
// statut (connecté/non connecté) l'est. Elle est chiffrée au repos (AES-256-GCM,
// voir odoo-crypto.util.ts) : la base de données ne contient jamais la clé en clair.
// ============================================================

enum OdooModuleId {
  crm
  documents
  rh
  facturation
  projets
}

model OdooConnection {
  society String @id

  url      String
  database String
  username String
  /// Payload chiffré "iv:authTag:ciphertext" — jamais la clé API en clair.
  apiKeyEncrypted String @map("api_key_encrypted")

  connected       Boolean   @default(false)
  lastConnectedAt DateTime? @map("last_connected_at")
  lastError       String?   @map("last_error")

  selectedModules OdooModuleId[] @map("selected_modules")

  fieldMappings    OdooFieldMapping[]
  migrationReports OdooMigrationReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("odoo_connections")
}

/// Ne redéfinit jamais QUEL champ Odoo alimente quelle colonne ATFM (fixé dans
/// odoo.constants.ts / OdooImportService) — seulement l'intitulé affiché dans
/// l'écran de correspondance, personnalisable par société (voir OdooMappingStep).
model OdooFieldMapping {
  id      String         @id @default(uuid())
  society String
  connection OdooConnection @relation(fields: [society], references: [society], onDelete: Cascade)

  moduleId  OdooModuleId @map("module_id")
  odooField String       @map("odoo_field")
  atfmLabel String       @map("atfm_label")

  @@unique([society, moduleId, odooField])
  @@map("odoo_field_mappings")
}

/// Un enregistrement par module importé à chaque exécution — jamais un état
/// "en cours" persistant : un import réel se termine ou échoue dans le cycle
/// de la requête HTTP qui le déclenche (voir OdooImportService.runImport).
model OdooMigrationReport {
  id      String         @id @default(uuid())
  society String
  connection OdooConnection @relation(fields: [society], references: [society], onDelete: Cascade)

  moduleId   OdooModuleId @map("module_id")
  available  Int          @map("available")
  imported   Int
  truncated  Boolean      @default(false)
  errors     String[]
  runAt      DateTime     @default(now()) @map("run_at")

  @@index([society])
  @@map("odoo_migration_reports")
}
